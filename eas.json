{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "store",
      "autoIncrement": true,
      "credentialsSource": "remote",
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://abm-backend.up.railway.app/api",
        "EXPO_PUBLIC_USE_MOCK_AUTH": "false"
      },
      "ios": {
        "simulator": false
      },
      "android": {}
    },
    "internal": {
      "distribution": "internal",
      "autoIncrement": true,
      "credentialsSource": "remote",
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://abm-backend.up.railway.app/api",
        "EXPO_PUBLIC_USE_MOCK_AUTH": "false"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://abm-backend.up.railway.app/api",
        "EXPO_PUBLIC_USE_MOCK_AUTH": "false"
      },
